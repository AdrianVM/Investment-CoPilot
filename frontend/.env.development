# Local development settings (non-secret). Override locally in .env.development.local.
# Sign-in provider: the local Keycloak from docker-compose.yml. Any OpenID Connect provider works.
VITE_OIDC_AUTHORITY=http://localhost:8080/realms/investment-copilot
VITE_OIDC_CLIENT_ID=investment-copilot-web
# Base URL of the API. Empty means same origin: the Vite dev server proxies /api to the backend.
VITE_API_BASE_URL=
