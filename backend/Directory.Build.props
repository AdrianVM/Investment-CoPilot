<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>InvestmentCoPilot.$(MSBuildProjectName)</RootNamespace>
    <AssemblyName>InvestmentCoPilot.$(MSBuildProjectName)</AssemblyName>
  </PropertyGroup>

  <!-- Module internals are visible to the test projects only. -->
  <ItemGroup Condition="'$(IsTestProject)' != 'true'">
    <InternalsVisibleTo Include="InvestmentCoPilot.UnitTests" />
    <InternalsVisibleTo Include="InvestmentCoPilot.IntegrationTests" />
  </ItemGroup>
</Project>
