<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Write the OpenAPI document to backend/openapi.json on every build; the frontend client is generated from it. -->
  <PropertyGroup>
    <OpenApiGenerateDocuments>true</OpenApiGenerateDocuments>
    <OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)/../..</OpenApiDocumentsDirectory>
    <OpenApiGenerateDocumentsOptions>--file-name openapi</OpenApiGenerateDocumentsOptions>
  </PropertyGroup>

  <!--
    The generator only re-runs when this project's own assembly changes. Endpoints live in the module projects,
    so also regenerate when any referenced project's assembly is newer than the last generated document.
  -->
  <Target Name="InvalidateOpenApiDocumentWhenModulesChange"
          BeforeTargets="GenerateOpenApiDocuments"
          Inputs="@(ReferencePath->WithMetadataValue('ReferenceSourceTarget', 'ProjectReference'))"
          Outputs="$(_OpenApiDocumentsCache)">
    <Delete Files="$(_OpenApiDocumentsCache)" />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\Modules\Identity\Identity\Identity.csproj" />
    <ProjectReference Include="..\Modules\MarketData\MarketData\MarketData.csproj" />
    <ProjectReference Include="..\Modules\Assessment\Assessment\Assessment.csproj" />
    <ProjectReference Include="..\SharedKernel\SharedKernel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>


</Project>
