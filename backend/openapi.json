{
  "openapi": "3.1.1",
  "info": {
    "title": "Investment Co-Pilot API",
    "version": "v1"
  },
  "paths": {
    "/api/me": {
      "get": {
        "tags": [
          "Users"
        ],
        "summary": "Get the signed-in user's profile",
        "operationId": "GetCurrentUser",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserProfile"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/api/market-data/stocks/{symbol}": {
      "get": {
        "tags": [
          "MarketData"
        ],
        "summary": "Get a stock's current fundamentals by ticker symbol",
        "description": "Money is in the stock's listing currency; percentages are fractions (0.15 = 15 %). Metrics the data source does not supply are null. When the source is unavailable, the last cached data is returned with isStale set.",
        "operationId": "GetStockFundamentals",
        "parameters": [
          {
            "name": "symbol",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StockFundamentals"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/assessments/{strategy}/stocks/{symbol}": {
      "get": {
        "tags": [
          "Assessment"
        ],
        "summary": "Assess a stock against an investment strategy",
        "description": "Strategy 'peter-lynch' checks Peter Lynch's six criteria. Each criterion is met, not met, or cannot be assessed (missing data or no exchange rate). Values use the fundamentals' units: fractions for percentages, plain ratios, and money with its currency. Computed on demand; for information only.",
        "operationId": "GetStockAssessment",
        "parameters": [
          {
            "name": "strategy",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "symbol",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StockAssessment"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AssessmentSummary": {
        "required": [
          "met",
          "notMet",
          "cannotAssess",
          "total"
        ],
        "type": "object",
        "properties": {
          "met": {
            "type": "integer",
            "format": "int32"
          },
          "notMet": {
            "type": "integer",
            "format": "int32"
          },
          "cannotAssess": {
            "type": "integer",
            "format": "int32"
          },
          "total": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "Comparison": {
        "enum": [
          "lessThan",
          "greaterThan"
        ]
      },
      "CriterionAssessment": {
        "required": [
          "id",
          "name",
          "verdict",
          "measures",
          "reason",
          "conversion"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "verdict": {
            "$ref": "#/components/schemas/Verdict"
          },
          "measures": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Measure"
            }
          },
          "reason": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/UnassessableReason"
              }
            ]
          },
          "conversion": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/CurrencyConversion"
              }
            ]
          }
        }
      },
      "CurrencyConversion": {
        "required": [
          "original",
          "converted",
          "rate",
          "source",
          "asOf"
        ],
        "type": "object",
        "properties": {
          "original": {
            "$ref": "#/components/schemas/Money"
          },
          "converted": {
            "$ref": "#/components/schemas/Money"
          },
          "rate": {
            "type": "number",
            "format": "double"
          },
          "source": {
            "type": "string"
          },
          "asOf": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Measure": {
        "required": [
          "id",
          "label",
          "value",
          "unit",
          "currency",
          "comparison",
          "threshold"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "value": {
            "type": [
              "null",
              "number"
            ],
            "format": "double"
          },
          "unit": {
            "$ref": "#/components/schemas/MeasureUnit"
          },
          "currency": {
            "type": [
              "null",
              "string"
            ]
          },
          "comparison": {
            "$ref": "#/components/schemas/Comparison"
          },
          "threshold": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "MeasureUnit": {
        "enum": [
          "ratio",
          "fraction",
          "money"
        ]
      },
      "Money": {
        "required": [
          "amount",
          "currency"
        ],
        "type": "object",
        "properties": {
          "amount": {
            "type": "number",
            "format": "double"
          },
          "currency": {
            "type": "string"
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "StockAssessment": {
        "required": [
          "strategyId",
          "strategyName",
          "symbol",
          "companyName",
          "source",
          "asOf",
          "isStale",
          "criteria",
          "summary"
        ],
        "type": "object",
        "properties": {
          "strategyId": {
            "type": "string"
          },
          "strategyName": {
            "type": "string"
          },
          "symbol": {
            "type": "string"
          },
          "companyName": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "asOf": {
            "type": "string",
            "format": "date-time"
          },
          "isStale": {
            "type": "boolean"
          },
          "criteria": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CriterionAssessment"
            }
          },
          "summary": {
            "$ref": "#/components/schemas/AssessmentSummary"
          }
        }
      },
      "StockFundamentals": {
        "required": [
          "symbol",
          "companyName",
          "currency",
          "price",
          "marketCap",
          "trailingPe",
          "forwardPe",
          "epsGrowth",
          "institutionalOwnership",
          "insiderOwnership",
          "debtToEquity",
          "source",
          "asOf",
          "isStale"
        ],
        "type": "object",
        "properties": {
          "symbol": {
            "type": "string"
          },
          "companyName": {
            "type": "string"
          },
          "currency": {
            "type": "string"
          },
          "price": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/Money"
              }
            ]
          },
          "marketCap": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/Money"
              }
            ]
          },
          "trailingPe": {
            "type": [
              "null",
              "number"
            ],
            "format": "double"
          },
          "forwardPe": {
            "type": [
              "null",
              "number"
            ],
            "format": "double"
          },
          "epsGrowth": {
            "type": [
              "null",
              "number"
            ],
            "format": "double"
          },
          "institutionalOwnership": {
            "type": [
              "null",
              "number"
            ],
            "format": "double"
          },
          "insiderOwnership": {
            "type": [
              "null",
              "number"
            ],
            "format": "double"
          },
          "debtToEquity": {
            "type": [
              "null",
              "number"
            ],
            "format": "double"
          },
          "source": {
            "type": "string"
          },
          "asOf": {
            "type": "string",
            "format": "date-time"
          },
          "isStale": {
            "type": "boolean"
          }
        }
      },
      "UnassessableReason": {
        "enum": [
          "dataNotAvailable",
          "exchangeRateNotAvailable",
          null
        ]
      },
      "UserProfile": {
        "required": [
          "id",
          "email",
          "displayName"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": [
              "null",
              "string"
            ]
          },
          "displayName": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "Verdict": {
        "enum": [
          "meets",
          "doesNotMeet",
          "cannotAssess"
        ]
      }
    },
    "securitySchemes": {
      "Bearer": {
        "type": "http",
        "description": "Access token from the configured OpenID Connect provider.",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "security": [
    {
      "Bearer": [ ]
    }
  ],
  "tags": [
    {
      "name": "Users"
    },
    {
      "name": "MarketData"
    },
    {
      "name": "Assessment"
    }
  ]
}